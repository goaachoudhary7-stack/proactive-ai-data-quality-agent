# Copy this file to .env and fill in a key there.
# .env is gitignored. Do not commit a real API key.

# Optional Gemini setup. Leave the key blank in this example.
# A model id that starts with gemini/ uses GEMINI_API_KEY or GOOGLE_API_KEY.
# CrewAI model id: provider/model-id
GEMINI_API_KEY=
DQ_INVESTIGATOR_MODEL=gemini/gemini-3.8-flash
